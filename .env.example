NODE_ENV=development
PORT=4000
# Local: role `pos`, database pos_dev. Tests use pos_test.
DATABASE_URL=postgres://pos:CHANGE_ME@127.0.0.1:5432/pos_dev
TEST_DATABASE_URL=postgres://pos:CHANGE_ME@127.0.0.1:5432/pos_test
# Generate per installation: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=16
